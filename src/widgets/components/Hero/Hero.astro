---
import { getSiteData } from '@data/site';
import Avatar from '@shared/ui/Avatar/Avatar.astro';
import Button from '@shared/ui/Button/Button.astro';
import { getLocale } from '@i18n/utils';
import RichText from '@shared/ui/RichText/RichText.astro';
import { getExperienceYears } from '@utils/experience';
import { getAvatarSrc } from '@utils/images';
import s from './Hero.module.scss';

const locale = getLocale(Astro);
const { hero: data, status } = getSiteData(locale);
const avatarSrc = await getAvatarSrc();

// Words are wrapped for the intro; the heading text stays exactly the same string.
const escape = (value: string) => value.replaceAll('&', '&amp;').replaceAll('<', '&lt;').replaceAll('>', '&gt;');
const titleHtml = data.title
  .split(' ')
  .map(
    (word, index) =>
      `<span class="${s.word}"><span class="${s.wordInner}" style="--i: ${index}">${escape(word)}</span></span>`
  )
  .join(' ');
---

<section class={s.hero} id="about">
  <div class="container">
    <div class={s.content}>
      <Avatar class={s.avatar} src={avatarSrc} />
      {status.open && (
        <p class={s.badge}>
          <span class={s.dot} aria-hidden="true" />
          {status.text.badge}
        </p>
      )}
      <h1 set:html={titleHtml} />
      <strong class:list={[s.role, 'text-xl', 'medium', 'accent']}>{data.role}</strong>
      <p class:list={[s.text, 'text-md', 'regular']}>
        <RichText text={data.text} vars={{ years: getExperienceYears() }} />
      </p>
      <div class={s.btns}>
        <Button href="#contacts">{data.button}</Button>
      </div>
    </div>
  </div>
</section>
