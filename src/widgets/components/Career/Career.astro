---
import type { SiteData } from '@data/site';
import ArrowControls from '@shared/ui/ArrowControls/ArrowControls.astro';
import Carousel from '@shared/ui/Carousel/Carousel.astro';
import RichText from '@shared/ui/RichText/RichText.astro';
import Tag from '@shared/ui/Tag/Tag.astro';
import s from './Career.module.scss';

interface Props {
  data: SiteData['career'];
  a11y: SiteData['a11y'];
}

const { data, a11y } = Astro.props;
const total = data.items.length;
const slideLabel = (index: number) =>
  a11y.slideOf.replace('{{index}}', String(index + 1)).replace('{{total}}', String(total));
---

<section id="career" class:list={[s.career, 'section']} data-career>
  <div class="container">
    <Carousel
      a11y={a11y}
      labelledby="career-title"
      options={{ align: 'start', dragFree: true, containScroll: 'trimSnaps' }}
    >
      <div class:list={[s.careerTop, 'title']} data-reveal>
        <h2 id="career-title">
          <RichText text={data.title} />
        </h2>
        <ArrowControls prevLabel={a11y.previousSlide} nextLabel={a11y.nextSlide} />
      </div>
      {/* A scrollable region must be reachable by keyboard until Embla takes over (it removes tabindex). */}
      {/* eslint-disable-next-line astro/jsx-a11y/no-noninteractive-tabindex */}
      <div class={s.viewport} data-embla-viewport tabindex="0" role="group" aria-labelledby="career-title">
        <div class={s.track} data-embla-container>
          {data.items.map((item, index) => (
            <div
              class={s.careerItem}
              data-embla-slide
              role="group"
              aria-roledescription={a11y.slide}
              aria-label={slideLabel(index)}
            >
              <article data-career-item data-current={item.end === null ? '' : undefined}>
                <h3 class="text-md medium">
                  <span class={s.name} data-career-name>
                    {item.company}
                  </span>
                </h3>
                <strong class="text-sm regular" data-career-meta>
                  <span>{item.position}</span>
                  <span>{item.year}</span>
                </strong>
                <span class={s.circle} data-career-circle>
                  <span class={s.ping} data-career-ping />
                </span>
                <div class={s.content} data-career-content>
                  <p class="text-sm" data-career-text>
                    <RichText text={item.description} />
                  </p>
                  <div class={s.technologies} data-career-tech>
                    <span class:list={['text-sm', { 'visually-hidden': index > 0 }]}>{data.technologies}:</span>
                    <div class={s.stack} data-career-stack>
                      {item.stack.map(stack => (
                        <Tag>{stack}</Tag>
                      ))}
                    </div>
                  </div>
                </div>
              </article>
            </div>
          ))}
        </div>
      </div>
    </Carousel>
  </div>
</section>

<script>
  // The reveal is a separate chunk, loaded when the section is about to be seen.
  const section = document.querySelector<HTMLElement>('[data-career]');

  if (section) {
    new IntersectionObserver(
      ([entry], observer) => {
        if (!entry.isIntersecting) return;
        observer.disconnect();
        void import('@shared/scripts/career-reveal').then(({ initCareerReveal }) => initCareerReveal(section));
      },
      { rootMargin: '400px' }
    ).observe(section);
  }
</script>
