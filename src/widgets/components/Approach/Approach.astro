---
import Copy from '@lucide/astro/icons/copy';
import { info } from '@data/global';
import type { SiteData } from '@data/site';
import { getCodeImages } from '@utils/images';
import Button from '@shared/ui/Button/Button.astro';
import CopyButton from '@shared/ui/CopyButton/CopyButton.astro';
import RichText from '@shared/ui/RichText/RichText.astro';
import StarBorder from '@shared/ui/StarBorder/StarBorder.astro';
import s from './Approach.module.scss';

interface Props {
  data: SiteData['approach'];
}

const { data } = Astro.props;
const codeImages = await getCodeImages();
---

<section class:list={[s.approach, 'section']} id="approach">
  <div class="container">
    <h2 class="title" data-reveal>
      <RichText text={data.title} />
    </h2>
    <div class={s.grid}>
      <article class:list={[s.item, s.item_1]} data-reveal style="--i: 0">
        <img
          width="480"
          height="480"
          src="/images/cooperation.svg"
          alt=""
          aria-hidden="true"
          loading="lazy"
          decoding="async"
        />
        <h3>{data.cooperation}</h3>
      </article>
      <article class:list={[s.item, s.item_2]} data-reveal style="--i: 1">
        <img
          width="340"
          height="353"
          src="/images/flexibility.svg"
          alt=""
          aria-hidden="true"
          loading="lazy"
          decoding="async"
        />
        <span class="text-sm">{data.approach}</span>
        <h3>{data.flexibility}</h3>
      </article>
      <article class:list={[s.item, s.item_3]} data-reveal style="--i: 2">
        <h3 class="text-xl">{data.ui}</h3>
        <svg aria-hidden="true" focusable="false" width="178" height="83" viewBox="0 0 178 83" fill="none">
          <path
            d="M167.897 0.0317383H10.1034C4.95386 0.0317383 0.779297 3.01116 0.779297 10.5V118.94C0.779297 126.429 4.95386 132.5 10.1034 132.5H167.897C173.046 132.5 177.221 126.429 177.221 118.94V10.5C177.221 3.01116 173.046 0.0317383 167.897 0.0317383Z"
            fill="#989898"
            fill-opacity="0.2"
          ></path>
          <path
            d="M24.0897 15.7C24.0897 11.7666 20.8785 8.578 16.9173 8.578C12.9561 8.578 9.74487 11.7666 9.74487 15.7C9.74487 19.6333 12.9561 22.8219 16.9173 22.8219C20.8785 22.8219 24.0897 19.6333 24.0897 15.7Z"
            fill="white"
            fill-opacity="0.15"
          ></path>
          <path
            d="M149.607 31.3683H12.6138C11.0294 31.3683 9.74487 32.6437 9.74487 34.2171C9.74487 35.7904 11.0294 37.0658 12.6138 37.0658H149.607C151.191 37.0658 152.476 35.7904 152.476 34.2171C152.476 32.6437 151.191 31.3683 149.607 31.3683Z"
            fill="white"
            fill-opacity="0.15"
          ></path>
          <path
            d="M62.1034 12.8512H33.4138C31.8293 12.8512 30.5448 14.1266 30.5448 15.7C30.5448 17.2733 31.8293 18.5488 33.4138 18.5488H62.1034C63.6879 18.5488 64.9724 17.2733 64.9724 15.7C64.9724 14.1266 63.6879 12.8512 62.1034 12.8512Z"
            fill="white"
            fill-opacity="0.15"
          ></path>
          <path
            d="M83.6207 12.8512H72.1448C70.5604 12.8512 69.2759 14.1266 69.2759 15.7C69.2759 17.2733 70.5604 18.5488 72.1448 18.5488H83.6207C85.2052 18.5488 86.4897 17.2733 86.4897 15.7C86.4897 14.1266 85.2052 12.8512 83.6207 12.8512Z"
            fill="white"
            fill-opacity="0.15"
          ></path>
          <path
            d="M69.2759 42.7634H12.6138C11.0294 42.7634 9.74487 44.0389 9.74487 45.6122C9.74487 47.1855 11.0294 48.461 12.6138 48.461H69.2759C70.8604 48.461 72.1449 47.1855 72.1449 45.6122C72.1449 44.0389 70.8604 42.7634 69.2759 42.7634Z"
            fill="white"
            fill-opacity="0.15"
          ></path>
        </svg>
      </article>
      <StarBorder tag="article" color="var(--accent)" class={[s.item, s.item_4]} data-reveal style="--i: 3">
        <div class={s.itemInner}>
          <h3>{data.together}</h3>
          <CopyButton text={info.email} success={data.success} error={data.error}>
            <Button size="sm">
              <Copy size={14} aria-hidden="true" />
              {data.email}
            </Button>
          </CopyButton>
        </div>
      </StarBorder>
      <article class:list={[s.item, s.item_5]} data-reveal style="--i: 4">
        <div class={s.item_text}>
          <span>{data.pomotomo}</span>
          <h3>{data.developing}</h3>
        </div>
        <img
          class={s.codeLight}
          width="510"
          height="292"
          src={codeImages.light}
          alt=""
          aria-hidden="true"
          loading="lazy"
          decoding="async"
        />
        <img
          class={s.codeDark}
          width="510"
          height="292"
          src={codeImages.dark}
          alt=""
          aria-hidden="true"
          loading="lazy"
          decoding="async"
        />
      </article>
    </div>
  </div>
</section>
