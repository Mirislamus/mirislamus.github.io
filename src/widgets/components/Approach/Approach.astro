---
import Copy from '@lucide/astro/icons/copy';
import LayoutTemplate from '@lucide/astro/icons/layout-template';
import Server from '@lucide/astro/icons/server';
import ShoppingCart from '@lucide/astro/icons/shopping-cart';
import { info } from '@data/global';
import type { SiteData } from '@data/site';
import Button from '@shared/ui/Button/Button.astro';
import CopyButton from '@shared/ui/CopyButton/CopyButton.astro';
import RichText from '@shared/ui/RichText/RichText.astro';
import Spotlight from '@shared/ui/Spotlight/Spotlight.astro';
import StarBorder from '@shared/ui/StarBorder/StarBorder.astro';
import Tag from '@shared/ui/Tag/Tag.astro';
import s from './Approach.module.scss';

interface Props {
  data: SiteData['approach'];
}

const { data } = Astro.props;
const typeIcons = { landing: LayoutTemplate, store: ShoppingCart, service: Server };
const chat = data.cooperation.chat;
// The conversation: who writes what and when (the times are the same in every language).
const messages = [
  { text: chat.ask, time: '10:24', mine: false },
  { text: chat.reply, link: chat.link, time: '10:25', mine: true },
  { text: chat.tweak, time: '10:27', mine: false },
  { text: chat.update, time: '10:28', mine: true, reaction: '👍' },
  { text: chat.approve, time: '10:30', mine: false },
];
const secret = data.secret;
const inviteHref = `${info.telegram}?text=${encodeURIComponent(secret.invite.text)}`;
---

<section class:list={[s.approach, 'section']} id="approach">
  <div class="container">
    <h2 class="title" data-reveal>
      <RichText text={data.title} />
    </h2>
    <div class={s.grid}>
      <article class:list={[s.item, s.item_1]} data-reveal data-spotlight data-tilt style="--i: 0">
        <Spotlight />
        <chat-demo class={s.chat}>
          <div class={s.window}>
            <div class={s.head} aria-hidden="true">
              <span class={s.avatar}>{chat.client[0]}</span>
              <span class={s.who}>
                <b>{chat.client}</b>
                <span class={s.state}>
                  <span class={s.online} data-chat-online>
                    {chat.status}
                  </span>
                  <span class={s.writing} data-chat-writing>
                    {chat.typing}
                  </span>
                </span>
              </span>
            </div>
            <div class={s.scroll}>
              <ol class={s.messages} aria-label={chat.label} data-chat-list>
                {messages.map(message => (
                  <li class:list={[s.message, message.mine && s.mine]}>
                    <p class={s.bubble}>
                      <span class="visually-hidden">{message.mine ? chat.me : chat.client}: </span>
                      {message.text.split(' ').map(word => (
                        <>
                          <span class={s.w} data-chat-word>
                            {word}
                          </span>{' '}
                        </>
                      ))}
                      {message.link && <span class={s.link}>{message.link}</span>}
                      <span class={s.meta} aria-hidden="true">
                        <span class={s.time}>{message.time}</span>
                        {message.mine && (
                          <span class={s.ticks}>
                            <svg
                              viewBox="0 0 16 16"
                              width="14"
                              height="14"
                              fill="none"
                              stroke="currentColor"
                              stroke-width="1.8"
                              stroke-linecap="round"
                              stroke-linejoin="round"
                            >
                              <path d="M2.5 8.5l3 3 6-6.5" />
                            </svg>
                            <svg
                              data-chat-read
                              viewBox="0 0 16 16"
                              width="14"
                              height="14"
                              fill="none"
                              stroke="currentColor"
                              stroke-width="1.8"
                              stroke-linecap="round"
                              stroke-linejoin="round"
                            >
                              <path d="M6.5 11.5l.8.8 6-6.5" />
                            </svg>
                          </span>
                        )}
                      </span>
                    </p>
                    {message.reaction && (
                      <span class={s.reaction} data-chat-reaction aria-hidden="true">
                        {message.reaction}
                      </span>
                    )}
                    <span class={s.typing} data-chat-typing aria-hidden="true">
                      <i />
                      <i />
                      <i />
                    </span>
                  </li>
                ))}
              </ol>
            </div>
            <div class={s.field} aria-hidden="true">
              <span>{chat.input}</span>
              <span class={s.send}>
                <svg
                  viewBox="0 0 16 16"
                  width="14"
                  height="14"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M8 13V3M3.5 7.5L8 3l4.5 4.5" />
                </svg>
              </span>
            </div>
          </div>
        </chat-demo>
        <div class={s.copy}>
          <h3>{data.cooperation.title}</h3>
          <p class={s.fact}>{data.cooperation.fact}</p>
        </div>
      </article>
      <article class:list={[s.item, s.item_2]} data-reveal data-spotlight data-tilt style="--i: 1">
        <Spotlight />
        <span class="text-sm">{data.flexibility.eyebrow}</span>
        <h3>{data.flexibility.title}</h3>
        <p class={s.fact}>{data.flexibility.fact}</p>
        <div class={s.types}>
          <div class={s.switcher} role="radiogroup" aria-label={data.flexibility.switcher}>
            {data.flexibility.types.map((type, index) => (
              <>
                <input
                  type="radio"
                  name="project-type"
                  id={`type-${type.id}`}
                  value={type.id}
                  class="visually-hidden"
                  checked={index === 0}
                />
                <label for={`type-${type.id}`}>
                  {(() => {
                    const Icon = typeIcons[type.id];
                    return <Icon size={22} aria-hidden="true" />;
                  })()}
                  {type.label}
                </label>
              </>
            ))}
          </div>
          <div class={s.panels}>
            {data.flexibility.types.map(type => (
              <div class={s.panel} data-type={type.id}>
                <p class={s.label}>{data.flexibility.stack}</p>
                <ul class={s.stack}>
                  {type.stack.map((name, index) => (
                    <li style={`--k: ${index}`}>
                      <Tag class={s.chip}>{name}</Tag>
                    </li>
                  ))}
                </ul>
                <p class={s.label}>{data.flexibility.stages}</p>
                <ol class={s.stages}>
                  {type.stages.map((stage, index) => (
                    <li style={`--k: ${index}`}>
                      <span class={s.node} aria-hidden="true" />
                      {stage}
                    </li>
                  ))}
                </ol>
              </div>
            ))}
          </div>
        </div>
      </article>
      <article class:list={[s.item, s.item_3]} data-reveal data-spotlight style="--i: 2">
        <Spotlight />
        <h3 class="text-xl">{data.ui.title}</h3>
        <p class={s.fact}>{data.ui.fact}</p>
        <ui-sandbox class={s.sandbox} style="--value: 65">
          <div class={s.row}>
            <label class={s.switchLabel}>
              <span class="visually-hidden">{data.ui.sandbox.toggle}</span>
              <input type="checkbox" role="switch" class={s.switch} />
            </label>
            <span class={s.status}>
              <span class={s.statusDot} aria-hidden="true" />
              {data.ui.sandbox.status}
            </span>
          </div>
          <div class={s.row}>
            <label class="visually-hidden" for="sandbox-range">
              {data.ui.sandbox.slider}
            </label>
            <input id="sandbox-range" type="range" min="0" max="100" value="65" class={s.range} />
            <output for="sandbox-range" class={s.value}>
              65%
            </output>
          </div>
          <div class={s.bar} aria-hidden="true" />
        </ui-sandbox>
      </article>
      <StarBorder tag="article" color="var(--accent)" class={[s.item, s.item_4]} data-reveal style="--i: 3">
        <div class={s.itemInner}>
          <h3>{data.together.title}</h3>
          <CopyButton text={info.email} success={data.together.success} error={data.together.error}>
            <Button size="sm">
              <Copy size={14} aria-hidden="true" />
              {data.together.email}
            </Button>
          </CopyButton>
        </div>
      </StarBorder>
      <article class:list={[s.item, s.item_5]} data-reveal data-spotlight style="--i: 4">
        <Spotlight />
        <secret-card class={s.secret}>
          <div class={s.intro}>
            <span class={s.stamp}>{secret.stamp}</span>
            <h3>{secret.title}</h3>
            <p class={s.fact}>{secret.line}</p>
          </div>
          <ul class={s.files}>
            {secret.rows.map(row => (
              <li>
                {/* A bar decrypts on keyboard focus too; the group is named by its sentence. */}
                {/* eslint-disable-next-line astro/jsx-a11y/no-noninteractive-tabindex */}
                <div class={s.file} role="group" tabindex="0" aria-label={row.label} data-file>
                  <div class={s.fileHead} aria-hidden="true">
                    <span>{row.code}</span>
                    <span>{row.progress}%</span>
                  </div>
                  <div class={s.redacted} aria-hidden="true">
                    {row.mask.map(length => (
                      <span class={s.word}>
                        {Array.from({ length }, () => (
                          <span class={s.ch} data-ch>
                            █
                          </span>
                        ))}
                      </span>
                    ))}
                  </div>
                  <div class={s.meter} aria-hidden="true">
                    <i style={`--p: ${row.progress / 100}`} data-meter />
                  </div>
                </div>
              </li>
            ))}
          </ul>
          <form
            class={s.invite}
            action="#approach"
            novalidate
            data-invite
            data-empty={secret.form.empty}
            data-denied={secret.form.denied}
          >
            <label class={s.inviteLabel} for="invite-code">
              {secret.form.heading}
            </label>
            <div class={s.inviteRow}>
              <input
                id="invite-code"
                type="text"
                class={s.input}
                placeholder={secret.form.label}
                aria-label={secret.form.label}
                autocomplete="off"
                autocapitalize="off"
                spellcheck="false"
                maxlength="64"
              />
              <Button type="submit">{secret.form.submit}</Button>
              <Button href={inviteHref} variant="outline">
                {secret.invite.button}
              </Button>
            </div>
            <p class={s.inviteStatus} role="status" data-invite-status></p>
          </form>
        </secret-card>
      </article>
    </div>
  </div>
</section>

<script>
  class UiSandbox extends HTMLElement {
    connectedCallback() {
      const range = this.querySelector<HTMLInputElement>('input[type="range"]');
      const output = this.querySelector('output');
      if (!range || !output) return;

      range.addEventListener('input', () => {
        this.style.setProperty('--value', range.value);
        output.value = `${range.value}%`;
      });
    }
  }

  // The chat scene and the classified card live in separate chunks, loaded a little before they are seen.
  const whenNear = (element: Element | null, load: () => void) => {
    if (!element) return;
    new IntersectionObserver(
      ([entry], observer) => {
        if (!entry.isIntersecting) return;
        observer.disconnect();
        load();
      },
      { rootMargin: '400px' }
    ).observe(element);
  };

  const chat = document.querySelector<HTMLElement>('#approach chat-demo');
  if (chat)
    whenNear(chat, () => void import('@shared/scripts/chat-demo').then(({ initChatDemo }) => initChatDemo(chat)));

  const secret = document.querySelector<HTMLElement>('#approach secret-card');
  if (secret) {
    whenNear(
      secret,
      () => void import('@shared/scripts/secret-card').then(({ initSecretCard }) => initSecretCard(secret))
    );
  }

  if (!customElements.get('ui-sandbox')) customElements.define('ui-sandbox', UiSandbox);
</script>
