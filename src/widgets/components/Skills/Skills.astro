---
import skillsData from '@data/skills/skills.json';
import { getLocale } from '@i18n/utils';
import s from './Skills.module.scss';

const locale = getLocale(Astro);
const data = skillsData.data[locale];
const titleParts = data.title.split('|');
---

<section class:list={[s.skills, 'section']} id="skills">
  <div class="container">
    <h2 class="title">
      {titleParts[0]}
      <span class="accent">{titleParts[1]}</span>
      {titleParts[2]}
    </h2>
    <div class={s.grid}>
      {skillsData.items.map(skill => (
        <a aria-label={skill.name} href={skill.link} class={s.skill} target="_blank" rel="noreferrer noopener">
          {skill.hasTheme ? (
            <>
              <img
                class={s.lightIcon}
                src={`/images/skills/${skill.id}-light.svg`}
                width="72"
                height="72"
                alt=""
                aria-hidden="true"
                loading="lazy"
                decoding="async"
              />
              <img
                class={s.darkIcon}
                src={`/images/skills/${skill.id}-dark.svg`}
                width="72"
                height="72"
                alt=""
                aria-hidden="true"
                loading="lazy"
                decoding="async"
              />
            </>
          ) : (
            <img
              src={`/images/skills/${skill.id}.${skill.format ?? 'svg'}`}
              width="72"
              height="72"
              alt=""
              aria-hidden="true"
              loading="lazy"
              decoding="async"
            />
          )}
          <span>{skill.name}</span>
        </a>
      ))}
    </div>
  </div>
</section>
