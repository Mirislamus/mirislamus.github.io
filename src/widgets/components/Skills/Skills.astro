---
import { getSiteData } from '@data/site';
import { getLocale } from '@i18n/utils';
import { getSkillIcon, monogramOf } from '@utils/skill-icons';
import { formatUsage, projectsUsing } from '@utils/skill-usage';
import RichText from '@shared/ui/RichText/RichText.astro';
import s from './Skills.module.scss';

const locale = getLocale(Astro);
const site = getSiteData(locale);
const { skills } = site;

// Columns for a group so that its rows are as even as possible and none is left half empty:
// 9 tiles at most 5 across make 5 + 4, 6 tiles make 3 + 3, 5 tiles make 3 + 2 (never a single row, so the
// groups side by side have the same height). The tiles of a row stretch to fill it.
const columns = (count: number, max: number) => Math.ceil(count / Math.max(2, Math.ceil(count / max)));
---

<section class:list={[s.skills, 'section']} id="skills">
  <div class="container">
    <h2 class="title" data-reveal>
      <RichText text={skills.title} />
    </h2>
    <div class={s.groups}>
      {skills.groups.map((group, index) => (
        <section class={s.group} aria-labelledby={`skills-${group.id}`} data-reveal style={`--i: ${index}`}>
          <h3 id={`skills-${group.id}`} class="text-lg medium">
            {group.title}
          </h3>
          <div
            class={s.grid}
            style={`--cols: ${columns(group.items.length, 5)}; --cols-sm: ${columns(group.items.length, 3)}`}
          >
            {group.items.map(skill => {
              const icon = skill.icon ? getSkillIcon(skill.icon) : null;
              // At rest the icon is the colour of the text; under the cursor it takes the colour of the brand (the accent
              // when the brand colour would be lost on the page).
              const brand = icon
                ? `--brand: ${icon.brandLight ?? 'var(--accent-text)'}; --brand-dark: ${icon.brandDark ?? 'var(--accent-text)'}`
                : undefined;

              const names = projectsUsing(skill.tech ?? skill.id, site.projects.items);
              const tip = formatUsage(names, skills.usage, locale);
              const tipId = `tip-${skill.id}`;

              return (
                <a
                  aria-label={skill.name}
                  href={skill.link}
                  class={s.skill}
                  target="_blank"
                  rel="noreferrer noopener"
                  style={brand}
                  aria-describedby={tip ? tipId : undefined}
                  data-tip={tip ? '' : undefined}
                >
                  {icon ? (
                    <svg class={s.icon} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                      <path d={icon.path} />
                    </svg>
                  ) : (
                    <svg class:list={[s.icon, s.monogram]} viewBox="0 0 24 24" fill="none" aria-hidden="true">
                      <rect x="1.5" y="1.5" width="21" height="21" rx="5.5" stroke="currentColor" stroke-width="1.6" />
                      <text
                        x="12"
                        y="12.2"
                        text-anchor="middle"
                        dominant-baseline="central"
                        font-size="9.5"
                        font-weight="700"
                        fill="currentColor"
                      >
                        {monogramOf(skill.name)}
                      </text>
                    </svg>
                  )}
                  <span class={s.label}>{skill.name}</span>
                  {tip && (
                    <span id={tipId} role="tooltip" class={s.tip}>
                      {tip}
                    </span>
                  )}
                </a>
              );
            })}
          </div>
        </section>
      ))}
    </div>
  </div>
</section>

<script>
  // On a touch screen there is no hover: the first tap on a tile that has a tooltip shows it, the second one opens the
  // link. A tap anywhere else closes it. A mouse never gets here.
  const section = document.querySelector<HTMLElement>('#skills');

  if (section) {
    const touch = window.matchMedia('(hover: none)');
    let armed: HTMLElement | null = null;

    document.addEventListener('click', event => {
      const tile = (event.target as Element).closest<HTMLElement>('#skills a[data-tip]');
      if (tile && touch.matches && tile !== armed) {
        event.preventDefault();
        armed?.removeAttribute('data-open');
        armed = tile;
        tile.setAttribute('data-open', '');
      } else if (!tile && armed) {
        armed.removeAttribute('data-open');
        armed = null;
      }
    });
  }
</script>
