---
import { getSiteData } from '@data/site';
import { info } from '@data/global';
import Button from '@shared/ui/Button/Button.astro';
import LocalTime from '@shared/ui/LocalTime/LocalTime.astro';
import Pills from '@shared/ui/Pills/Pills.astro';
import Relic from '@shared/ui/Relic/Relic.astro';
import Wordmark from '@shared/ui/Wordmark/Wordmark.astro';
import { getLocale } from '@i18n/utils';
import s from './Footer.module.scss';

const locale = getLocale(Astro);
const {
  footer: { ready, text },
  status,
  easter,
  relic,
} = getSiteData(locale);
---

<footer id="contacts" class={s.footer}>
  <div class="container">
    <div class={s.wrapper}>
      <div class={s.content}>
        <h2 class="text-xxl">
          <strong>{ready}</strong>
          <span class:list={[s.footerText, 'accent']}>{text}</span>
        </h2>
        <div class={s.buttons} data-magnetic>
          <Button variant="outline" fluid href={`mailto:${info.email}`} class={s.magnet} data-magnet>
            <span class={s.magnetText} data-magnet-text>
              {info.email}
            </span>
          </Button>
          <Button variant="outline" fluid href={info.telegram} class={s.magnet} data-magnet>
            <span class={s.magnetText} data-magnet-text>
              {info.telegram.replace('https://', '')}
            </span>
          </Button>
        </div>
        <div class={s.local}>
          <LocalTime status={status} locale={locale} />
        </div>
      </div>
      <Wordmark name="mirislamus" />
      <div class={s.bottom}>
        <span class={s.copyright}>
          &copy; {new Date().getFullYear()} mirislamus.github.io
          {/* The way into the easter egg: quiet, but it is there. */}
          <button type="button" class={s.rabbit} data-rabbit aria-label={easter.rabbit}>
            <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true">
              <ellipse class={s.ear} cx="9.2" cy="5.2" rx="1.7" ry="4.4" transform="rotate(-12 9.2 5.2)" />
              <ellipse class={s.ear} cx="14.4" cy="5" rx="1.7" ry="4.6" transform="rotate(10 14.4 5)" />
              <circle cx="12" cy="11.4" r="3.6" />
              <ellipse cx="12.8" cy="18" rx="5.8" ry="4.6" />
              <circle cx="19" cy="19.4" r="1.5" />
            </svg>
          </button>
          {/* The second way in, and a different one: the Relic chip opens Johnny Silverhand. */}
          <button type="button" class={s.chip} data-relic aria-label={relic.chip}>
            <svg
              viewBox="0 0 24 24"
              width="20"
              height="20"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              aria-hidden="true"
            >
              <path d="M6 5h12a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1Z" />
              <path d="M9 9h6v6H9zM2.5 9H5M2.5 15H5M19 9h2.5M19 15h2.5M9 2.5V5M15 2.5V5M9 19v2.5M15 19v2.5" />
            </svg>
            {['red', 'cyan'].map(tone => (
              <svg
                class:list={[s.ghost, s[tone]]}
                data-relic-ghost
                viewBox="0 0 24 24"
                width="20"
                height="20"
                fill="none"
                stroke="currentColor"
                stroke-width="1.6"
                aria-hidden="true"
              >
                <path d="M6 5h12a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1Z" />
                <path d="M9 9h6v6H9zM2.5 9H5M2.5 15H5M19 9h2.5M19 15h2.5M9 2.5V5M15 2.5V5M9 19v2.5M15 19v2.5" />
              </svg>
            ))}
          </button>
        </span>
        <ul class="list-reset">
          <li>
            <a href={info.telegram} target="_blank" rel="noopener noreferrer">
              Telegram ↗
            </a>
          </li>
          <li>
            <a href={info.github} target="_blank" rel="noopener noreferrer">
              GitHub ↗
            </a>
          </li>
          <li>
            <a href={info.linkedin} target="_blank" rel="noopener noreferrer">
              LinkedIn ↗
            </a>
          </li>
        </ul>
      </div>
    </div>
  </div>
</footer>

<Pills texts={easter} />
<Relic texts={relic} />

<script>
  // The scene is a separate chunk, loaded only when the rabbit is clicked.
  document.querySelector('[data-rabbit]')?.addEventListener('click', () => {
    void import('@shared/scripts/matrix/pills').then(({ openPills }) => openPills());
  });

  // The Relic chip (J-01) is a chunk of its own as well. It glitches once the first time the footer is seen; hover and
  // focus play the same glitch from CSS.
  const chip = document.querySelector<HTMLElement>('[data-relic]');

  if (chip) {
    chip.addEventListener('click', () => {
      void import('@shared/scripts/relic/relic').then(({ openRelic }) => openRelic());
    });
    new IntersectionObserver(
      ([entry], observer) => {
        if (!entry.isIntersecting) return;
        observer.disconnect();
        chip.setAttribute('data-glitch', '');
        chip.addEventListener('animationend', () => chip.removeAttribute('data-glitch'), { once: true });
      },
      { threshold: 1 }
    ).observe(chip);
  }

  // The buttons that lean towards the cursor (A-11) are a small chunk, loaded when the footer is about to be seen.
  const magnetic = document.querySelector<HTMLElement>('[data-magnetic]');

  if (magnetic) {
    new IntersectionObserver(
      ([entry], observer) => {
        if (!entry.isIntersecting) return;
        observer.disconnect();
        void import('@shared/scripts/magnetic').then(({ initMagnetic }) => initMagnetic(magnetic));
      },
      { rootMargin: '400px' }
    ).observe(magnetic);
  }
</script>
