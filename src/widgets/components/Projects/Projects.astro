---
import type { SiteData } from '@data/site';
import { getProjectImages } from '@utils/images';
import Button from '@shared/ui/Button/Button.astro';
import RichText from '@shared/ui/RichText/RichText.astro';
import Spotlight from '@shared/ui/Spotlight/Spotlight.astro';
import Tag from '@shared/ui/Tag/Tag.astro';
import s from './Projects.module.scss';

interface Props {
  data: SiteData['projects'];
}

const { data } = Astro.props;
const images = await getProjectImages();
const INITIAL_COUNT = 4;
const hasMore = data.items.length > INITIAL_COUNT;
---

<section id="projects" class:list={[s.projects, 'section']}>
  <div class="container">
    <h2 class="title" data-reveal>
      <RichText text={data.title} />
    </h2>
    <projects-list>
      <div class={s.filters} data-filters role="group" aria-label={data.filter.label}>
        <button type="button" class={s.chip} data-filter="" aria-pressed="true">
          {data.filter.all}
        </button>
        {data.filters.map(filter => (
          <button type="button" class={s.chip} data-filter={filter.id} aria-pressed="false">
            {filter.name}
          </button>
        ))}
        <p class={s.count} role="status" data-count data-forms={JSON.stringify(data.filter.count)}></p>
      </div>

      <div class={s.grid}>
        {data.items.map((project, index) => {
          const image = images[project.id];
          const isExtra = index >= INITIAL_COUNT;

          return (
            <article
              class={s.project}
              data-spotlight
              data-tilt
              data-stack={project.stackIds.join(' ')}
              data-extra={isExtra ? '' : undefined}
              data-reveal={isExtra ? undefined : ''}
              style={`--i: ${index % 2}; --spotlight-color: ${project.color}`}
              hidden={isExtra}
            >
              <Spotlight />
              <div class={s.projectImage}>
                <picture>
                  <source type="image/avif" srcset={image.avif} />
                  <source type="image/webp" srcset={image.webp} />
                  <img
                    src={image.src}
                    alt=""
                    width={image.width}
                    height={image.height}
                    loading="lazy"
                    decoding="async"
                  />
                </picture>
              </div>
              <h3>
                <a class={s.link} href={project.link} target="_blank" rel="noopener noreferrer">
                  {project.name}
                </a>
              </h3>
              <p class="text-lg">{project.text}</p>
              <div class={s.bottom}>
                <div class={s.stack}>
                  {project.stack.map(stack => (
                    <Tag class={s.tag}>{stack}</Tag>
                  ))}
                </div>
              </div>
            </article>
          );
        })}
      </div>

      {hasMore && (
        <div class={s.actions} data-more-wrap>
          <Button variant="outline" data-more>
            {data.loadMore}
          </Button>
        </div>
      )}
    </projects-list>

    {/* Without JavaScript there is nothing to filter or expand: show every project, no controls. */}
    <noscript>
      <style>
        #projects [data-extra] {
          display: block;
        }
        #projects [data-more-wrap],
        #projects [data-filters] {
          display: none;
        }
      </style>
    </noscript>
  </div>
</section>

<script>
  class ProjectsList extends HTMLElement {
    connectedCallback() {
      const cards = [...this.querySelectorAll<HTMLElement>('article')];
      const chips = [...this.querySelectorAll<HTMLButtonElement>('[data-filter]')];
      const more = this.querySelector<HTMLElement>('[data-more]');
      const wrap = this.querySelector<HTMLElement>('[data-more-wrap]');
      const count = this.querySelector<HTMLElement>('[data-count]');
      const forms = JSON.parse(count?.dataset.forms ?? '{}') as Record<string, string>;
      const plural = new Intl.PluralRules(document.documentElement.lang);

      let expanded = false;
      let filter = '';

      // Cards that appear now fade in one after another; toggling the attribute off and on replays it.
      const reveal = (shown: HTMLElement[]) =>
        shown.forEach((card, index) => {
          card.style.setProperty('--i', String(index));
          card.toggleAttribute('data-revealed', false);
          void card.offsetWidth;
          card.toggleAttribute('data-revealed', true);
        });

      const apply = () => {
        const filtering = filter !== '';
        const appeared: HTMLElement[] = [];

        for (const card of cards) {
          const matches = !filtering || (card.dataset.stack ?? '').split(' ').includes(filter);
          const shown = filtering ? matches : !card.hasAttribute('data-extra') || expanded;
          if (shown && card.hidden) appeared.push(card);
          card.hidden = !shown;
        }
        reveal(appeared);

        // "Show more" has nothing to do while filtering (a filter shows every match).
        if (wrap) wrap.hidden = filtering || expanded;

        chips.forEach(chip => chip.setAttribute('aria-pressed', String((chip.dataset.filter ?? '') === filter)));

        if (count) {
          const total = cards.filter(card => !card.hidden).length;
          count.textContent = filtering
            ? (forms[plural.select(total)] ?? forms.other ?? '').replace('{{count}}', String(total))
            : '';
        }
      };

      for (const chip of chips) {
        // Choosing the active chip again clears the filter.
        chip.addEventListener('click', () => {
          const next = chip.dataset.filter ?? '';
          filter = next === filter ? '' : next;
          apply();
        });
      }

      more?.addEventListener('click', () => {
        expanded = true;
        apply();
        // The button disappears, so keyboard users continue from the first new card.
        cards
          .find(card => card.hasAttribute('data-extra'))
          ?.querySelector<HTMLElement>('a')
          ?.focus();
      });
    }
  }

  if (!customElements.get('projects-list')) customElements.define('projects-list', ProjectsList);
</script>
