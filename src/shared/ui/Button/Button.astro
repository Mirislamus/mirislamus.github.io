---
import type { HTMLAttributes } from 'astro/types';
import s from './Button.module.scss';

interface Props extends Omit<HTMLAttributes<'a'>, 'class' | 'type'> {
  href?: string;
  variant?: 'fill' | 'outline';
  size?: 'sm' | 'lg';
  fluid?: boolean;
  disabled?: boolean;
  class?: string;
}

const { href, variant = 'fill', size = 'lg', fluid, disabled, class: className, ...rest } = Astro.props;

// Only real web links open in a new tab; mailto:, tel: and in-page anchors do not.
const isExternal = href !== undefined && /^https?:\/\//.test(href);
const Tag = href === undefined ? 'button' : 'a';
---

<Tag
  href={href}
  target={isExternal ? '_blank' : undefined}
  rel={isExternal ? 'noopener noreferrer' : undefined}
  type={href === undefined ? ('button' as const) : undefined}
  disabled={href === undefined ? disabled : undefined}
  data-ripple
  class:list={[s.button, s[variant], s[size], { [s.fluid]: fluid, [s.disabled]: disabled }, className]}
  {...rest}
>
  <slot />
</Tag>
