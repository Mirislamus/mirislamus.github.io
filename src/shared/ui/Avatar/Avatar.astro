---
import type { HTMLAttributes } from 'astro/types';

interface Props extends Omit<HTMLAttributes<'svg'>, 'src'> {
  src: string;
}

const { src, ...rest } = Astro.props;

// Both outlines have the same structure (M + four C + Z), so the browser can interpolate between them.
const shapeA = 'M130 10C190 0 260 70 250 130C240 200 170 250 100 240C30 230 10 170 20 100C30 30 70 20 130 10Z';
const shapeB = 'M130 0C180 0 250 60 250 130C250 200 180 260 130 260C80 260 10 200 10 130C10 60 80 0 130 0Z';
---

<!-- Decorative: the name is already in the page heading. -->
<svg data-avatar width="260" height="260" viewBox="0 0 260 260" fill="none" aria-hidden="true" {...rest}>
  <defs>
    <linearGradient
      id="avatar-gradient"
      x1="20.0342"
      y1="127.858"
      x2="240.429"
      y2="130.181"
      gradientUnits="userSpaceOnUse"
    >
      <stop stop-color="var(--orange)"></stop>
      <stop offset="1" stop-color="var(--purple)"></stop>
    </linearGradient>

    <mask id="avatar-mask">
      <path d={shapeA} fill="white">
        <animate
          attributeName="d"
          values={`${shapeA};${shapeB};${shapeA}`}
          keyTimes="0;0.5;1"
          calcMode="spline"
          keySplines="0.45 0 0.55 1;0.45 0 0.55 1"
          dur="4s"
          repeatCount="indefinite"
        ></animate>
      </path>
    </mask>
  </defs>

  <g mask="url(#avatar-mask)">
    <rect fill="url(#avatar-gradient)" width="260" height="260"></rect>
    <image href={src} width="260" height="260" preserveAspectRatio="xMidYMid" transform="translate(20 35)" />
  </g>
</svg>

<script>
  // The morph is a decorative endless loop: keep it still for reduced motion and while off screen.
  const avatar = document.querySelector<SVGSVGElement>('[data-avatar]');

  if (avatar) {
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    let onScreen = true;

    const update = () => (reduceMotion.matches || !onScreen ? avatar.pauseAnimations() : avatar.unpauseAnimations());

    new IntersectionObserver(([entry]) => {
      onScreen = entry.isIntersecting;
      update();
    }).observe(avatar);
    reduceMotion.addEventListener('change', update);
    update();
  }
</script>
