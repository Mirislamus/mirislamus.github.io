---
import type { HTMLAttributes } from 'astro/types';

interface Props extends Omit<HTMLAttributes<'svg'>, 'src'> {
  src: string;
}

const { src, ...rest } = Astro.props;

// The outline without JavaScript, and while the animation is paused. With the Hero effects loaded the
// mask is redrawn every frame as a liquid blob (shared/scripts/matrix/liquid.ts).
const shapeA = 'M130 10C190 0 260 70 250 130C240 200 170 250 100 240C30 230 10 170 20 100C30 30 70 20 130 10Z';
---

<!-- Decorative: the name is already in the page heading. -->
<svg data-avatar width="260" height="260" viewBox="0 0 260 260" fill="none" aria-hidden="true" {...rest}>
  <defs>
    <linearGradient
      id="avatar-gradient"
      x1="20.0342"
      y1="127.858"
      x2="240.429"
      y2="130.181"
      gradientUnits="userSpaceOnUse"
    >
      <stop stop-color="var(--orange)"></stop>
      <stop offset="1" stop-color="var(--purple)"></stop>
    </linearGradient>

    <mask id="avatar-mask">
      <path data-avatar-shape data-shape-a={shapeA} d={shapeA} fill="white"></path>
    </mask>
  </defs>

  <g mask="url(#avatar-mask)">
    {/* Larger than the viewBox: a stretched drop reaches beyond it. */}
    <rect fill="url(#avatar-gradient)" x="-100" y="-100" width="460" height="460"></rect>
    <g data-photo>
      <image href={src} width="260" height="260" preserveAspectRatio="xMidYMid" transform="translate(20 35)" />
    </g>
  </g>
</svg>
