---
import type { HTMLAttributes } from 'astro/types';

import s from './StarBorder.module.scss';

interface Props extends Omit<HTMLAttributes<'div'>, 'class' | 'style'> {
  tag?: string;
  color?: string;
  speed?: string;
  thickness?: number;
  class?: string | string[];
  style?: string;
}

const { tag = 'div', color = 'white', speed = '6s', thickness = 1, class: className, style, ...rest } = Astro.props;
const Tag = tag as 'div';
const vars = `--star-color: ${color}; --star-speed: ${speed}; --star-thickness: ${thickness}px;`;
---

<Tag class:list={[s.container, className]} style={`${vars}${style ?? ''}`} {...rest}>
  <div class={s.gradientBottom}></div>
  <div class={s.gradientTop}></div>
  <slot />
</Tag>
