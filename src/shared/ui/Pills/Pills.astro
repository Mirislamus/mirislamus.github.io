---
import { hands } from '@data/matrix/hands';
import type { SiteData } from '@data/site';
import { handsGap } from '@shared/scripts/matrix/hands-layout';
import s from './Pills.module.scss';

interface Props {
  texts: SiteData['easter'];
}

const { texts } = Astro.props;

// The hands are glyphs on a canvas (shared/scripts/matrix/hands-fx.ts); the page only knows where the two capsules
// are, to put the real buttons over them. Both sizes of the grid have the same proportions, so one set is enough.
const grid = hands.desktop;
const gap = handsGap(grid.cols);
const total = grid.cols * 2 + gap;
const where = {
  '--ratio': (total * 0.6) / grid.rows,
  '--red-x': `${(grid.pill.x / total) * 100}%`,
  '--blue-x': `${((grid.cols + gap + (grid.cols - grid.pill.x)) / total) * 100}%`,
  '--pill-y': `${(grid.pill.y / grid.rows) * 100}%`,
};
---

<dialog
  class={s.dialog}
  data-pills
  data-end-blue={texts.blueEnd}
  data-end-red={texts.redEnd}
  aria-labelledby="pills-title"
  aria-describedby="pills-text"
>
  <canvas class={s.rain} data-pills-rain aria-hidden="true"></canvas>

  <div class={s.stage} data-pills-stage>
    <h2 id="pills-title" class={s.title}>
      {texts.title}
    </h2>
    <p id="pills-text" class={s.text}>
      {texts.text}
    </p>

    <div class={s.hands} role="group" aria-label={texts.hint} style={where} data-pills-hands>
      <canvas class={s.canvas} aria-hidden="true"></canvas>
      <button type="button" class:list={[s.pill, s.blue]} data-pill="blue" aria-label={texts.blue}></button>
      <button type="button" class:list={[s.pill, s.red]} data-pill="red" aria-label={texts.red}></button>
    </div>
  </div>

  <p class={s.result} data-pills-result hidden></p>

  <button type="button" class={s.close} data-pills-close aria-label={texts.close}>
    <svg
      viewBox="0 0 24 24"
      width="22"
      height="22"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      aria-hidden="true"
    >
      <path d="M6 6l12 12M18 6L6 18" stroke-linecap="round"></path>
    </svg>
  </button>
</dialog>
