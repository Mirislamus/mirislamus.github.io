---
import type { TerminalData } from '@shared/scripts/terminal-commands';
import s from './Terminal.module.scss';

interface Props {
  data: TerminalData;
}

const { data } = Astro.props;

// `<` is escaped so the data can never close the script element.
const json = JSON.stringify(data).replaceAll('<', '\\u003c');
---

<dialog id="terminal" class={s.terminal} aria-label={data.label}>
  <div class={s.screen}>
    {/* The log scrolls, so keyboard users must be able to focus it (axe: scrollable-region-focusable). */}
    {/* eslint-disable-next-line astro/jsx-a11y/no-noninteractive-tabindex */}
    <div class={s.log} role="log" tabindex="0" aria-live="polite" aria-label={data.label} data-log></div>
    <div class={s.row}>
      <label for="terminal-input" class={s.prompt}>
        {data.prompt}
      </label>
      <input
        id="terminal-input"
        class={s.input}
        type="text"
        autocomplete="off"
        autocapitalize="off"
        spellcheck="false"
        aria-label={data.label}
      />
    </div>
  </div>
  <script is:inline type="application/json" id="terminal-data" set:html={json}></script>
</dialog>
