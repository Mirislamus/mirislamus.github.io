---
import type { HTMLAttributes } from 'astro/types';
import s from './ActionButton.module.scss';

interface Props extends Omit<HTMLAttributes<'button'>, 'class' | 'type'> {
  class?: string;
}

const { class: className, ...rest } = Astro.props;
---

<button type="button" data-ripple class:list={[s.actionButton, className]} {...rest}>
  <slot />
</button>
