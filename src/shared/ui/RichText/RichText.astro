---
import { parseRichText, type RichTextVars } from '@utils/rich-text';

interface Props {
  text: string;
  vars?: RichTextVars;
}

const { text, vars } = Astro.props;

const escape = (value: string) =>
  value.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');

// Built as a string on purpose: whitespace around inline elements is significant, and a formatter
// must not be able to add any.
const html = parseRichText(text, vars)
  .map(token => {
    if (token.type === 'highlight') return `<span class="accent">${escape(token.value)}</span>`;
    if (token.type === 'link') {
      return `<a href="${escape(token.href)}" target="_blank" rel="noopener noreferrer">${escape(token.label)}</a>`;
    }
    return escape(token.value);
  })
  .join('');
---

<Fragment set:html={html} />
