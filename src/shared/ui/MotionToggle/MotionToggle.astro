---
import Pause from '@lucide/astro/icons/pause';
import Play from '@lucide/astro/icons/play';
import s from './MotionToggle.module.scss';

interface Props {
  pauseLabel: string;
  playLabel: string;
  /** Pinned to the viewport corner (the 404 page) instead of the corner of its positioned parent (the Hero). */
  fixed?: boolean;
}

const { pauseLabel, playLabel, fixed = false } = Astro.props;
---

<!-- Hidden until the script knows that there is something to pause (and the system does not already ask for reduced motion). -->
<motion-toggle hidden>
  <button
    type="button"
    class:list={[s.button, { [s.fixed]: fixed }]}
    aria-pressed="false"
    aria-label={pauseLabel}
    data-label={pauseLabel}
    data-pause-label={pauseLabel}
    data-play-label={playLabel}
  >
    <Pause size={16} aria-hidden="true" class={s.pause} />
    <Play size={16} aria-hidden="true" class={s.play} />
  </button>
</motion-toggle>

<script>
  import { getMotion, onMotionChange } from '@shared/scripts/matrix/motion';

  // Pause, Stop, Hide (WCAG 2.2.2): the Matrix effects never stop on their own, so there is a button.
  class MotionToggle extends HTMLElement {
    connectedCallback() {
      const button = this.querySelector('button');
      if (!button) return;
      const motion = getMotion();

      const render = () => {
        // With reduced motion nothing moves, so there is nothing to pause.
        this.hidden = motion.reduced;
        button.setAttribute('aria-pressed', String(motion.paused));
        const label = (motion.paused ? button.dataset.playLabel : button.dataset.pauseLabel) ?? '';
        button.setAttribute('aria-label', label);
        button.dataset.label = label;
      };

      button.addEventListener('click', () => motion.setPaused(!motion.paused));
      onMotionChange(render);
      render();
    }
  }

  customElements.define('motion-toggle', MotionToggle);
</script>
