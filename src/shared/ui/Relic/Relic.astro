---
import type { SiteData } from '@data/site';
import { mask } from '@data/matrix/mask';
import s from './Relic.module.scss';

interface Props {
  texts: SiteData['relic'];
}

const { texts } = Astro.props;
---

{/* The scene of the Relic chip (J-02): a modal dialog like the one with the pills, always dark. The mask is glyphs on a canvas (J-07). */}
<dialog class={s.dialog} data-relic-scene aria-label={texts.title}>
  <div class={s.stage} style={`--ratio:${mask.ratio}`}>
    <canvas class={s.figure} data-relic-mask aria-hidden="true"></canvas>
    <div class={s.scan} aria-hidden="true"></div>
  </div>

  <div class={s.words}>
    {/* The shown line is noise to a screen reader, so it gets the whole quote in one clean piece. */}
    <p class="visually-hidden" lang="en">
      Wake up, Samurai. We have a city to burn.
    </p>
    <p class={s.line} lang="en" aria-hidden="true" data-relic-line="1"></p>
    <p class={s.line} lang="en" aria-hidden="true" data-relic-line="2"></p>
    {texts.subtitle && (
      <p class={s.subtitle} data-relic-subtitle hidden>
        {texts.subtitle}
      </p>
    )}
  </div>

  <button type="button" class={s.close} data-relic-close aria-label={texts.close}>
    <svg
      viewBox="0 0 24 24"
      width="22"
      height="22"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      aria-hidden="true"
    >
      <path d="M6 6l12 12M18 6L6 18" stroke-linecap="round"></path>
    </svg>
  </button>
</dialog>

{/* The secure channel (J-10): the fixer and the netrunner talk about the section that comes into view. Shown and filled
    only during the takeover; the log is a polite live region. The talk itself is in data-chat, the template is a message. */}
<section
  class={s.chat}
  data-relic-chat
  data-chat={JSON.stringify(texts.chat)}
  aria-labelledby="relic-chat-title"
  lang={Astro.currentLocale}
  hidden
>
  <header class={s.chatHead}>
    <span class={s.chatDot} aria-hidden="true"></span>
    <h2 id="relic-chat-title" class={s.chatTitle}>
      {texts.chat.title}
    </h2>
    <button
      type="button"
      class={s.chatToggle}
      data-relic-chat-toggle
      aria-expanded="true"
      aria-controls="relic-chat-body"
      aria-label={texts.chat.close}
    >
      <span class={s.badge} data-relic-chat-badge hidden></span>
      <svg
        class={s.chevron}
        viewBox="0 0 24 24"
        width="20"
        height="20"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M6 9l6 6 6-6"></path>
      </svg>
    </button>
  </header>
  <div id="relic-chat-body" class={s.chatBody} data-relic-chat-body>
    <div class={s.log} data-relic-chat-log role="log" aria-live="polite" aria-labelledby="relic-chat-title">
      <ol class={s.list} data-relic-chat-list></ol>
    </div>
    <p class={s.typing} data-relic-chat-typing aria-hidden="true" hidden></p>
  </div>
  <template data-relic-chat-message>
    <li class={s.message}>
      <span class={s.avatar} aria-hidden="true" data-avatar></span>
      <div class={s.bubble}>
        <p class={s.meta}>
          <span class={s.who} data-who></span>
          <time class={s.time} data-time></time>
        </p>
        <p class={s.text} data-text></p>
        <div class={s.replies} data-replies hidden>
          <button type="button" class={s.reply} data-reply></button>
        </div>
      </div>
    </li>
  </template>
</section>

{/* The plate that stays while the netrunner is in the site (J-06): the way out, and the sound. */}
<div class={s.plate} data-relic-plate hidden>
  <button type="button" class={s.eject} data-relic-eject>
    {texts.eject}
  </button>
  <button
    type="button"
    class={s.sound}
    data-relic-sound
    data-on={texts.soundOn}
    data-off={texts.soundOff}
    aria-label={texts.soundOn}
    aria-pressed="false"
    hidden
  >
    <svg
      viewBox="0 0 24 24"
      width="22"
      height="22"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M4 9.5v5h3.5L12 18.5v-13L7.5 9.5H4Z"></path>
      <path class={s.waves} d="M15.5 9a4.2 4.2 0 0 1 0 6M18 6.5a8 8 0 0 1 0 11"></path>
      <path class={s.muted} d="M16 9.5l5 5M21 9.5l-5 5"></path>
    </svg>
  </button>
</div>
