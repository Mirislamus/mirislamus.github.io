---
import '@styles/global.scss';
import Head from '@layouts/Head.astro';
import Footer from '@widgets/components/Footer/Footer.astro';
import Header from '@widgets/components/Header/Header.astro';
import { ToastProvider } from '@shared/ui/ToastProvider/ToastProvider';
import { getLanguageLinks, getLocale, localeUrl } from '@i18n/utils';
import { getSiteData } from '@data/site';

const locale = getLocale(Astro);
const { a11y, meta, menu } = getSiteData(locale);
---

<!doctype html>
<html lang={locale}>
  <Head locale={locale} meta={meta} />
  <body>
    <a class="skip-link" href="#main-content">
      {a11y.skipToContent}
    </a>
    <script>
      import '@shared/scripts/ripple';
      import { initTheme } from '@utils/theme';
      initTheme();
    </script>
    <Header locale={locale} homeHref={localeUrl(locale)} languages={getLanguageLinks(locale)} menu={menu} a11y={a11y} />
    <main id="main-content" class="locale-content" tabindex="-1">
      <slot />
    </main>
    <ToastProvider client:load />
    <Footer />
  </body>
</html>
