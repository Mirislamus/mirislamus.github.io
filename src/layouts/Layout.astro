---
import type { Locale } from '@typings/global';
import '@styles/global.scss';
import Head from '@layouts/Head.astro';
import { Header, Footer } from '@widgets/components';
import { ToastProvider } from '@shared/ui';
import { localeAtom } from '@shared/stores';

const locale = (Astro.currentLocale ?? 'en') as Locale;

localeAtom.set(locale);
---

<!doctype html>
<html lang={locale}>
  <Head locale={locale} />
  <body>
    <script>
      import { initThemeStore } from '@utils/theme';
      initThemeStore();
    </script>
    <Header client:visible />
    <main class="locale-content">
      <slot />
    </main>
    <ToastProvider client:load />
    <Footer client:visible />
  </body>
</html>
