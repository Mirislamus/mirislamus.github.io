---
import type { SiteData } from '@data/site';
import { info } from '@data/global';
import { DEFAULT_LOCALE, LOCALES, LOCALE_META, type Locale } from '@i18n/locales';
import { absoluteLocaleUrl } from '@i18n/utils';
import { getSiteData } from '@data/site';
import { getLastModified } from '@seo/last-modified';
import { buildStructuredData } from '@seo/structured-data';
import { getAvatarImage, getProjectImages } from '@utils/images';
import { INTRO_STORAGE_KEY, bootstrapIntro } from '@utils/intro-bootstrap';
import { THEME_COLORS, THEME_STORAGE_KEY, bootstrapTheme } from '@utils/theme-bootstrap';

interface Props {
  locale: Locale;
  meta: SiteData['meta'];
}

const { locale, meta } = Astro.props;

const toUrl = (path: string) => new URL(path, Astro.site).href;
const canonical = absoluteLocaleUrl(locale);
const defaultUrl = absoluteLocaleUrl(DEFAULT_LOCALE);
const themeScript = `(${bootstrapTheme})(${JSON.stringify(THEME_STORAGE_KEY)}, ${JSON.stringify(THEME_COLORS)})`;
const introScript = `(${bootstrapIntro})(${JSON.stringify(INTRO_STORAGE_KEY)})`;
const site = getSiteData(locale);
const projectImages = await getProjectImages();
const avatar = await getAvatarImage();
const structuredData = buildStructuredData({
  locale,
  site,
  names: Object.fromEntries(LOCALES.map(code => [code, getSiteData(code).meta.name])) as Record<Locale, string>,
  origin: toUrl('/'),
  canonical,
  avatar: { url: toUrl(avatar.src), width: avatar.width, height: avatar.height },
  projectImages: Object.fromEntries(Object.entries(projectImages).map(([id, image]) => [id, toUrl(image.src)])),
  modified: getLastModified(),
  contacts: info,
});
---

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={meta.description} />
  <meta name="robots" content="max-image-preview:large" />

  <link rel="icon" href="/favicon.ico" sizes="48x48" />
  <link rel="icon" type="image/svg+xml" href="/favicon-light.svg" media="(prefers-color-scheme: light)" />
  <link rel="icon" type="image/svg+xml" href="/favicon-dark.svg" media="(prefers-color-scheme: dark)" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/manifest.webmanifest" />

  <meta name="color-scheme" content="light dark" />
  <meta name="theme-color" content={THEME_COLORS.light} media="(prefers-color-scheme: light)" />
  <meta name="theme-color" content={THEME_COLORS.dark} media="(prefers-color-scheme: dark)" />

  <meta property="og:title" content={meta.title} />
  <meta property="og:description" content={meta.description} />
  <meta property="og:image" content={toUrl('/opengraph.jpg')} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={meta.imageAlt} />
  <meta property="og:url" content={canonical} />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content={LOCALE_META[locale].ogLocale} />

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={meta.title} />
  <meta name="twitter:description" content={meta.description} />
  <meta name="twitter:image" content={toUrl('/opengraph.jpg')} />
  <meta name="twitter:image:alt" content={meta.imageAlt} />

  <link rel="canonical" href={canonical} />
  {LOCALES.map(code => (
    <link rel="alternate" hreflang={code} href={absoluteLocaleUrl(code)} />
  ))}
  <link rel="alternate" hreflang="x-default" href={defaultUrl} />

  <title>{meta.title}</title>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)}></script>
  <meta name="google-site-verification" content="Tzn3iaYEQS1a2OgHpkhiLftCIEJTMl_Psub9fGV1c0A" />
  <meta name="yandex-verification" content="f95a00340036f6fa" />

  <script is:inline set:html={themeScript}></script>
  <script is:inline set:html={introScript}></script>
</head>
