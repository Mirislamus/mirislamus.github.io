---
import '@/styles/base/_fonts.scss';
import { getSiteData } from '@/data/site';
import { LOCALES, isLocale } from '@/i18n/locales';
import Logo from '@/shared/icons/Logo.astro';
import { getAvatarSrc } from '@/utils/images';

export const getStaticPaths = () => LOCALES.map(lang => ({ params: { lang } }));

const { lang } = Astro.params;
if (!isLocale(lang)) throw new Error(`Unsupported OG locale "${lang}"`);

const { hero, meta } = getSiteData(lang);
const avatar = await getAvatarSrc();
if (!Astro.site) throw new Error('site is not set in astro.config.ts');
const host = Astro.site.host;

const shape = 'M130 10C190 0 260 70 250 130C240 200 170 250 100 240C30 230 10 170 20 100C30 30 70 20 130 10Z';
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=1200" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{meta.title}</title>
  </head>
  <body>
    <main>
      <Logo class="logo" width="56" height="56" />
      <svg class="avatar" width="240" height="240" viewBox="0 0 260 260" fill="none" aria-hidden="true">
        <defs>
          <linearGradient id="gradient" x1="20" y1="128" x2="240" y2="130" gradientUnits="userSpaceOnUse">
            <stop stop-color="#3e7bfa"></stop>
            <stop offset="1" stop-color="#e5484d"></stop>
          </linearGradient>
          <mask id="mask">
            <path d={shape} fill="white"></path>
          </mask>
        </defs>
        <g mask="url(#mask)">
          <rect fill="url(#gradient)" width="260" height="260"></rect>
          <image href={avatar} width="260" height="260" transform="translate(20 35)" />
        </g>
      </svg>
      <h1>{hero.title}</h1>
      <p class="role">{hero.role}</p>
      <p class="line">{meta.imageLine}</p>
      <p class="host">{host}</p>
    </main>
  </body>
</html>

<style is:global>
  *,
  *::before,
  *::after {
    margin: 0;
    box-sizing: border-box;
  }

  html,
  body {
    width: 1200px;
    height: 630px;
    overflow: hidden;
    font-family: Inter, system-ui, sans-serif;
    color: #fff;
    background: #121212;
  }

  main {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    height: 100%;
    padding-top: 44px;
    text-align: center;
  }

  .logo {
    position: absolute;
    top: 40px;
    left: 44px;
  }

  .avatar {
    margin-bottom: 22px;
  }

  h1 {
    font-size: 76px;
    font-weight: 700;
    line-height: 1.1;
  }

  .role {
    margin-top: 6px;
    font-size: 40px;
    font-weight: 500;
    color: #ff6433;
  }

  .line {
    margin-top: 14px;
    font-size: 28px;
    color: #b3b3b3;
  }

  .host {
    position: absolute;
    bottom: 26px;
    font-size: 22px;
    color: #808080;
  }
</style>
