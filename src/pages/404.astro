---
import '@/styles/global.scss';
import { getSiteData } from '@/data/site';
import { DEFAULT_LOCALE, LOCALES } from '@/i18n/locales';
import { localeUrl } from '@/i18n/utils';
import Button from '@/shared/ui/Button/Button.astro';
import MotionToggle from '@/shared/ui/MotionToggle/MotionToggle.astro';
import Wordmark from '@/shared/ui/Wordmark/Wordmark.astro';
import { pickLanguage } from '@/utils/language-bootstrap';
import { THEME_COLORS, THEME_STORAGE_KEY, bootstrapTheme } from '@/utils/theme-bootstrap';

const messages = {
  en: { title: 'Page not found', text: 'This page does not exist or has moved.', home: 'Go to the home page' },
  ru: { title: 'Страница не найдена', text: 'Такой страницы нет или она переехала.', home: 'На главную' },
  uz: { title: 'Sahifa topilmadi', text: 'Bunday sahifa yo‘q yoki ko‘chirilgan.', home: 'Bosh sahifaga' },
} as const;

const languageScript = `(${pickLanguage})(${JSON.stringify(LOCALES)}, ${JSON.stringify(DEFAULT_LOCALE)})`;
const themeScript = `(${bootstrapTheme})(${JSON.stringify(THEME_STORAGE_KEY)}, ${JSON.stringify(THEME_COLORS)})`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>404 — Mirislam Usmanov</title>
    <meta name="robots" content="noindex" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content={THEME_COLORS.light} media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content={THEME_COLORS.dark} media="(prefers-color-scheme: dark)" />
    <link rel="icon" type="image/svg+xml" href="/favicon-light.svg" media="(prefers-color-scheme: light)" />
    <link rel="icon" type="image/svg+xml" href="/favicon-dark.svg" media="(prefers-color-scheme: dark)" />
    <script is:inline set:html={themeScript}></script>
  </head>
  <body>
    <canvas class="rain" data-backdrop aria-hidden="true"></canvas>
    <main class="not-found" data-content>
      <div class="code">
        <Wordmark name="404" eager />
      </div>
      <p class="spoon" lang="en">
        There is no spoon.
      </p>
      {LOCALES.map(locale => (
        <section lang={locale} hidden={locale !== DEFAULT_LOCALE}>
          <h1>{messages[locale].title}</h1>
          <p>{messages[locale].text}</p>
          <Button href={localeUrl(locale)}>{messages[locale].home}</Button>
          <MotionToggle
            fixed
            pauseLabel={getSiteData(locale).a11y.motionPause}
            playLabel={getSiteData(locale).a11y.motionPlay}
          />
        </section>
      ))}
    </main>
    <script is:inline set:html={languageScript}></script>
    <script>
      import '@/shared/scripts/ripple';
      import { initTheme } from '@/utils/theme';
      initTheme();

      const canvas = document.querySelector<HTMLCanvasElement>('canvas[data-backdrop]');
      if (canvas) {
        const content = document.querySelector<HTMLElement>('[data-content]');
        void import('@/shared/scripts/matrix/backdrop-fx').then(({ initBackdrop }) => initBackdrop(canvas, content));
      }
    </script>
  </body>
</html>

<style>
  .not-found {
    display: flex;
    flex-direction: column;
    gap: var(--gap-30);
    align-items: center;
    justify-content: center;
    min-height: 100vh;
    padding: var(--gap-24) var(--gap-16);
    text-align: center;
  }
  .rain {
    position: fixed;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .not-found {
    position: relative;
    z-index: var(--z-base);
  }

  .code {
    width: min(560px, 100%);
  }

  .spoon {
    margin-top: calc(var(--gap-12) * -1);
    font-size: 18px;
    color: var(--accent-text);
  }

  section[hidden] {
    display: none;
  }

  section {
    display: flex;
    flex-direction: column;
    gap: var(--gap-12);
    align-items: center;
  }

  h1 {
    font-size: 32px;
  }

  section p {
    color: var(--text-muted);
  }
</style>
