---
import Layout from '@layouts/Layout.astro';
import { Approach } from '@widgets/components/Approach/Approach';
import { Career } from '@widgets/components/Career/Career';
import Hero from '@widgets/components/Hero/Hero.astro';
import { Projects } from '@widgets/components/Projects/Projects';
import { Reviews } from '@widgets/components/Reviews/Reviews';
import Skills from '@widgets/components/Skills/Skills.astro';

export function getStaticPaths() {
  return [{ params: { lang: undefined } }, { params: { lang: 'uz' } }, { params: { lang: 'ru' } }];
}
---

<Layout>
  <Hero />
  <Approach client:visible />
  <Career client:visible />
  <Projects client:visible />
  <Skills />
  <Reviews client:visible />
</Layout>
