---
import Layout from '@layouts/Layout.astro';
import Approach from '@widgets/components/Approach/Approach.astro';
import { Career } from '@widgets/components/Career/Career';
import Hero from '@widgets/components/Hero/Hero.astro';
import { Projects } from '@widgets/components/Projects/Projects';
import { Reviews } from '@widgets/components/Reviews/Reviews';
import Skills from '@widgets/components/Skills/Skills.astro';
import { getProjectImages } from '@utils/images';
import { getSiteData } from '@data/site';
import { getLocale, staticLocalePaths } from '@i18n/utils';

export const getStaticPaths = staticLocalePaths;

const locale = getLocale(Astro);
const site = getSiteData(locale);
const projectImages = await getProjectImages();
---

<Layout>
  <Hero />
  <Approach data={site.approach} />
  <Career client:visible data={site.career} a11y={site.a11y} />
  <Projects client:visible data={site.projects} images={projectImages} />
  <Skills />
  <Reviews client:visible data={site.reviews} a11y={site.a11y} />
</Layout>
