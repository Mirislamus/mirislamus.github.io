---
import { getSiteData } from '@/data/site';
import { LOCALES, isLocale } from '@/i18n/locales';
import Cv from '@/widgets/components/Cv/Cv.astro';

export const getStaticPaths = () => LOCALES.map(lang => ({ params: { lang } }));

const { lang } = Astro.params;
if (!isLocale(lang)) throw new Error(`Unsupported CV locale "${lang}"`);

const data = getSiteData(lang);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="color-scheme" content="light" />
    <title>{data.hero.title} — {data.hero.role}</title>
  </head>
  <body>
    <Cv data={data} site={Astro.site as URL} />
  </body>
</html>

<style is:global>
  @page {
    margin: 12mm 15mm;
    size: A4;
  }

  *,
  *::before,
  *::after {
    margin: 0;
    box-sizing: border-box;
  }

  body {
    background: #fff;
  }
</style>
