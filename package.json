    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.63.0",
    "eslint": "^10.11.0",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "globals": "^17.12.0",
    "knip": "^6.38.0",
