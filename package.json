{
  "name": "mirislamus.github.io",
  "packageManager": "bun@1.4.2",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "check": "astro check",
    "check:links": "bun scripts/check-links.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "format": "bunx prettier --write .",
    "format:check": "bunx prettier --check .",
    "check:bundle": "node scripts/check-bundle.mjs",
    "lint": "bunx eslint . --ext .js,.jsx,.ts,.tsx,.astro",
    "test:visual": "playwright test tests/visual",
    "test:visual:update": "playwright test tests/visual --update-snapshots",
    "knip": "knip --include files,exports,dependencies",
    "test": "vitest run",
    "test:e2e": "playwright test tests/e2e"
  },
  "dependencies": {
    "@astrojs/react": "6.0.6",
    "@astrojs/sitemap": "^3.7.4",
    "@lucide/astro": "^1.49.0",
    "astro": "7.3.3",
    "lucide-react": "^1.47.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "swiper": "^14.2.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/ts-plugin": "^1.10.12",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.63.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.1",
    "clsx": "^2.1.1",
    "cssnano": "^9.0.5",
    "eslint": "^10.11.0",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^17.12.0",
    "knip": "^6.38.0",
    "postcss": "^8.5.28",
    "postcss-preset-env": "^11.5.3",
    "prettier": "3.9.8",
    "prettier-plugin-astro": "1.0.1",
    "sass": "^1.104.1",
    "sharp": "^0.35.4",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.2"
  }
}
